# MusicAgent local configuration example.
# Copy to .env for local runs. Never commit real credential values.
# See .env.local-llm-profiles.example for model/routing profiles covering
# minimum laptops through high-end home workstation setups.

MUSICAGENT_INPUT_MODE=copy
MUSICAGENT_LLM_PROVIDER=stub
MUSICAGENT_DEPLOYMENT_PROFILE=app
MUSICAGENT_OUTPUT_ROOT=outputs

# Dockerised local LLM mode.
# Use with the Compose local-llm profile. The API key below is a local placeholder
# for the Ollama OpenAI-compatible endpoint, not a real hosted-provider credential.
#
# MUSICAGENT_LLM_PROVIDER=openai-compatible
# MUSICAGENT_MODEL=llama3.1:8b
# MUSICAGENT_OPENAI_BASE_URL=http://ollama:11434/v1
# OPENAI_API_KEY=ollama-local-placeholder
#
# Optional low-resource switch. When enabled, this model overrides the default and
# per-agent models for all agents so the same setup can run on constrained machines.
# MUSICAGENT_LOW_RESOURCE_MODEL=llama3.2:3b
# MUSICAGENT_USE_LOW_RESOURCE_MODEL=false
#
# Optional per-agent model routing. Pull these models into the Ollama Docker volume
# before enabling them.
# MUSICAGENT_AGENT_MODEL_LYRICIST_POET=mistral-nemo:12b
# MUSICAGENT_AGENT_MODEL_TOPLINER=mistral-nemo:12b
# MUSICAGENT_AGENT_MODEL_CYBER_CRITIC=qwen2.5:14b
# MUSICAGENT_AGENT_MODEL_REVIEWER=qwen2.5:14b
# MUSICAGENT_AGENT_MODEL_GROOVE_ARCHITECT=llama3.1:8b
# MUSICAGENT_AGENT_MODEL_SOUND_DESIGNER=llama3.1:8b
# MUSICAGENT_AGENT_MODEL_HARMONIC_ACCOMPANIST=llama3.1:8b

# Required only for hosted/non-local providers.
OPENAI_API_KEY=
MUSICAGENT_MODEL=
MUSICAGENT_OPENAI_BASE_URL=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=
