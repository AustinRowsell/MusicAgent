# MusicAgent Dockerised local LLM workstation profiles.
#
# Copy one profile block into .env when you want to run the local-llm Compose
# profile. Keep .env local and never commit real hosted-provider credentials.
# All OPENAI_API_KEY values below are local placeholders for the Ollama
# OpenAI-compatible endpoint.
#
# Usage:
#   1. Pick one profile below.
#   2. Copy that block to .env.
#   3. Pull every model referenced by that profile, for example:
#      ./scripts/docker-local-llm-pull.sh llama3.1:8b
#   4. Run ./scripts/docker-local-llm-check.sh before generating projects.

################################################################################
# Profile 0: Offline/stub baseline
################################################################################
# Lowest requirements: any machine that can run Python or the MusicAgent app
# container. No LLM container, model download, GPU, or networked model call.
# Best for: CI, tests, demos, deterministic output, machines that cannot run LLMs.

# MUSICAGENT_INPUT_MODE=copy
# MUSICAGENT_LLM_PROVIDER=stub
# MUSICAGENT_DEPLOYMENT_PROFILE=app
# MUSICAGENT_OUTPUT_ROOT=outputs

################################################################################
# Profile 1: Minimum Docker local LLM
################################################################################
# Lowest practical LLM setup.
# Approx requirements: Docker Desktop with 4-8 GB memory available to containers.
# Runtime: Ollama container.
# Models to pull:
#   ./scripts/docker-local-llm-pull.sh llama3.2:3b
# Best for: proving the full Dockerised local LLM path works on constrained machines.
# Trade-off: fast but shallow outputs; not the quality target for final music work.

# MUSICAGENT_INPUT_MODE=copy
# MUSICAGENT_LLM_PROVIDER=openai-compatible
# MUSICAGENT_DEPLOYMENT_PROFILE=app
# MUSICAGENT_OUTPUT_ROOT=outputs
# MUSICAGENT_MODEL=llama3.2:3b
# MUSICAGENT_OPENAI_BASE_URL=http://ollama:11434/v1
# OPENAI_API_KEY=ollama-local-placeholder
# MUSICAGENT_LOW_RESOURCE_MODEL=llama3.2:3b
# MUSICAGENT_USE_LOW_RESOURCE_MODEL=true

################################################################################
# Profile 2: Standard laptop local LLM
################################################################################
# Recommended broad-compatibility setup.
# Approx requirements: Docker Desktop with 8-16 GB memory available to containers.
# Runtime: Ollama container.
# Models to pull:
#   ./scripts/docker-local-llm-pull.sh llama3.1:8b
#   ./scripts/docker-local-llm-pull.sh llama3.2:3b
# Best for: everyday local development and general crew output.

# MUSICAGENT_INPUT_MODE=copy
# MUSICAGENT_LLM_PROVIDER=openai-compatible
# MUSICAGENT_DEPLOYMENT_PROFILE=app
# MUSICAGENT_OUTPUT_ROOT=outputs
# MUSICAGENT_MODEL=llama3.1:8b
# MUSICAGENT_OPENAI_BASE_URL=http://ollama:11434/v1
# OPENAI_API_KEY=ollama-local-placeholder
# MUSICAGENT_LOW_RESOURCE_MODEL=llama3.2:3b
# MUSICAGENT_USE_LOW_RESOURCE_MODEL=false
# MUSICAGENT_AGENT_MODEL_GROOVE_ARCHITECT=llama3.1:8b
# MUSICAGENT_AGENT_MODEL_SOUND_DESIGNER=llama3.1:8b
# MUSICAGENT_AGENT_MODEL_HARMONIC_ACCOMPANIST=llama3.1:8b

################################################################################
# Profile 3: Creative songwriter workstation
################################################################################
# Recommended creative-routing setup.
# Approx requirements: Docker Desktop with 16-32 GB memory available to containers.
# Runtime: Ollama container.
# Models to pull:
#   ./scripts/docker-local-llm-pull.sh llama3.1:8b
#   ./scripts/docker-local-llm-pull.sh llama3.2:3b
#   ./scripts/docker-local-llm-pull.sh mistral-nemo:12b
#   ./scripts/docker-local-llm-pull.sh qwen2.5:14b
# Best for: serious local use with lyric/topline and critic model specialisation.
# Routing:
#   default/general agents -> llama3.1:8b
#   lyricist/topliner      -> mistral-nemo:12b
#   critic/reviewer        -> qwen2.5:14b
#   low-resource override  -> llama3.2:3b

# MUSICAGENT_INPUT_MODE=copy
# MUSICAGENT_LLM_PROVIDER=openai-compatible
# MUSICAGENT_DEPLOYMENT_PROFILE=app
# MUSICAGENT_OUTPUT_ROOT=outputs
# MUSICAGENT_MODEL=llama3.1:8b
# MUSICAGENT_OPENAI_BASE_URL=http://ollama:11434/v1
# OPENAI_API_KEY=ollama-local-placeholder
# MUSICAGENT_LOW_RESOURCE_MODEL=llama3.2:3b
# MUSICAGENT_USE_LOW_RESOURCE_MODEL=false
# MUSICAGENT_AGENT_MODEL_LYRICIST_POET=mistral-nemo:12b
# MUSICAGENT_AGENT_MODEL_TOPLINER=mistral-nemo:12b
# MUSICAGENT_AGENT_MODEL_CYBER_CRITIC=qwen2.5:14b
# MUSICAGENT_AGENT_MODEL_REVIEWER=qwen2.5:14b
# MUSICAGENT_AGENT_MODEL_GROOVE_ARCHITECT=llama3.1:8b
# MUSICAGENT_AGENT_MODEL_SOUND_DESIGNER=llama3.1:8b
# MUSICAGENT_AGENT_MODEL_HARMONIC_ACCOMPANIST=llama3.1:8b

################################################################################
# Profile 4: Quality workstation
################################################################################
# Higher-quality local setup for machines with more memory/GPU capacity.
# Approx requirements: Docker Desktop with 32-64 GB memory available to containers,
# or a capable GPU-backed Docker setup.
# Runtime: Ollama container first; vLLM can be evaluated later for GPU throughput.
# Models to pull:
#   ./scripts/docker-local-llm-pull.sh qwen2.5:32b
#   ./scripts/docker-local-llm-pull.sh mistral-nemo:12b
#   ./scripts/docker-local-llm-pull.sh llama3.2:3b
# Best for: better structured reasoning and critique while keeping a creative lyric model.

# MUSICAGENT_INPUT_MODE=copy
# MUSICAGENT_LLM_PROVIDER=openai-compatible
# MUSICAGENT_DEPLOYMENT_PROFILE=app
# MUSICAGENT_OUTPUT_ROOT=outputs
# MUSICAGENT_MODEL=qwen2.5:32b
# MUSICAGENT_OPENAI_BASE_URL=http://ollama:11434/v1
# OPENAI_API_KEY=ollama-local-placeholder
# MUSICAGENT_LOW_RESOURCE_MODEL=llama3.2:3b
# MUSICAGENT_USE_LOW_RESOURCE_MODEL=false
# MUSICAGENT_AGENT_MODEL_LYRICIST_POET=mistral-nemo:12b
# MUSICAGENT_AGENT_MODEL_TOPLINER=mistral-nemo:12b
# MUSICAGENT_AGENT_MODEL_CYBER_CRITIC=qwen2.5:32b
# MUSICAGENT_AGENT_MODEL_REVIEWER=qwen2.5:32b
# MUSICAGENT_AGENT_MODEL_GROOVE_ARCHITECT=qwen2.5:32b
# MUSICAGENT_AGENT_MODEL_SOUND_DESIGNER=qwen2.5:32b
# MUSICAGENT_AGENT_MODEL_HARMONIC_ACCOMPANIST=qwen2.5:32b

################################################################################
# Profile 5: Highest reasonable home setup
################################################################################
# Experimental high-end local setup.
# Approx requirements: 64 GB+ memory available to containers or a strong GPU setup.
# Runtime: Ollama container can be used first; vLLM should be evaluated if throughput
# or concurrent serving becomes the bottleneck.
# Models to pull:
#   ./scripts/docker-local-llm-pull.sh llama3.1:70b
#   ./scripts/docker-local-llm-pull.sh qwen2.5:32b
#   ./scripts/docker-local-llm-pull.sh mistral-nemo:12b
#   ./scripts/docker-local-llm-pull.sh llama3.2:3b
# Best for: maximum local quality experiments, not the default developer workflow.
# Trade-off: large downloads, slow cold starts, high memory pressure.

# MUSICAGENT_INPUT_MODE=copy
# MUSICAGENT_LLM_PROVIDER=openai-compatible
# MUSICAGENT_DEPLOYMENT_PROFILE=app
# MUSICAGENT_OUTPUT_ROOT=outputs
# MUSICAGENT_MODEL=qwen2.5:32b
# MUSICAGENT_OPENAI_BASE_URL=http://ollama:11434/v1
# OPENAI_API_KEY=ollama-local-placeholder
# MUSICAGENT_LOW_RESOURCE_MODEL=llama3.2:3b
# MUSICAGENT_USE_LOW_RESOURCE_MODEL=false
# MUSICAGENT_AGENT_MODEL_LYRICIST_POET=mistral-nemo:12b
# MUSICAGENT_AGENT_MODEL_TOPLINER=mistral-nemo:12b
# MUSICAGENT_AGENT_MODEL_CYBER_CRITIC=qwen2.5:32b
# MUSICAGENT_AGENT_MODEL_REVIEWER=qwen2.5:32b
# MUSICAGENT_AGENT_MODEL_GROOVE_ARCHITECT=llama3.1:70b
# MUSICAGENT_AGENT_MODEL_SOUND_DESIGNER=llama3.1:70b
# MUSICAGENT_AGENT_MODEL_HARMONIC_ACCOMPANIST=qwen2.5:32b

################################################################################
# Runtime alternatives for future evaluation
################################################################################
# Keep MusicAgent configured through the OpenAI-compatible provider. If switching
# from Ollama to another Dockerised runtime later, only the base URL and model
# names should change.
#
# LocalAI candidate:
# MUSICAGENT_OPENAI_BASE_URL=http://localai:8080/v1
#
# llama.cpp server candidate:
# MUSICAGENT_OPENAI_BASE_URL=http://llama-cpp:8080/v1
#
# vLLM candidate:
# MUSICAGENT_OPENAI_BASE_URL=http://vllm:8000/v1
